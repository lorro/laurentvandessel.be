---
import { cn } from '@/lib/cn';
import { cardVariants } from './card.variants';

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  href,
  class: className,
  ...attrs
} = Astro.props;

const Element = href ? 'a' : 'div';

const cardStyles = cn(
  cardVariants({ variant, padding, hover }),
  href && 'block',
  className
);
---

<Element class={cardStyles} href={href} {...attrs}>
  <slot />
</Element>
