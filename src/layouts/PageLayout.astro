---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

const { title, description, image, imageAlt, noindex, nofollow } = Astro.props;

const socialLinks = [
  { platform: 'twitter', href: 'https://x.com/laurent_vd', label: 'Twitter' },
  { platform: 'github', href: 'https://github.com/lorro', label: 'GitHub' },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
>
  <Header
    slot="header"
    position="sticky"
    size="md"
    showActiveState
    showThemeToggle={false}
    showCta={false}
  />

  <main class="min-h-screen pt-4">
    <slot />
  </main>

  <Footer
    slot="footer"
    layout="simple"
    copyright="© {year} Laurent Van Dessel. All rights reserved."
    socialLinks={socialLinks}
    showSocial={true}
    hideLogo={true}
  />
</BaseLayout>
