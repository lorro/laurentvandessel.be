---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  showDeveloperVisual = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
>
  <Header
    slot="header"
    position="sticky"
    size="md"
    showActiveState
    showCta={false}
    showThemeToggle={false}
  />

  <slot />

  <Footer
    slot="footer"
    layout="simple"
    copyright="© {year} Laurent Van Dessel. All rights reserved."
    socialLinks={[
      { platform: 'twitter', href: 'https://x.com/laurent_vd', label: 'Twitter' },
      { platform: 'github', href: 'https://github.com/lorro', label: 'GitHub' },
    ]}
    showSocial={true}
    hideLogo={true}
  />
</BaseLayout>
