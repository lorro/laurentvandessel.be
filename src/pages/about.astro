---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
---

<PageLayout
  title="About"
  description="I'm Laurent Van Dessel, full-stack web developer at Inbound, based in Antwerp, Belgium."
>
  <Hero layout="centered" size="sm" showGrid>
    <Badge slot="badge" pill>About Me</Badge>

    <h1 slot="title">
      Hi, I'm <span class="text-brand-500">Laurent.</span>
    </h1>

    <p slot="description">
      Full-stack web developer at Inbound, based in Antwerp, Belgium, with a focus on building reliable
      websites and web applications that blend clean design with practical engineering.
    </p>
  </Hero>

  <!-- Extended bio -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-4 flex items-center gap-3">
        <span class="font-display text-sm font-semibold uppercase tracking-wider text-brand-500">Really? Still here?!</span>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <p class="mb-6 text-lg leading-relaxed text-foreground-secondary">
        I spend most of my time working with HTML, CSS, PHP and JavaScript. Over the last decade I mainly
        developed websites and applications with WordPress, CakePHP, and Laravel. I also enjoy Vue.js for
        modern front-end work, and I like pairing with AI tools such as Claude Code and Open Code to speed
        up ideation and implementation.
      </p>
    </div>
  </section>

  <!-- Hobbies -->
  <section class="bg-background-secondary py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display mb-8 text-2xl font-bold text-foreground">Outside of work</h2>

      <Card padding="lg">
        <div class="flex items-start gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
            <Icon name="activity" size="md" />
          </div>
          <div>
            <p class="text-lg leading-relaxed text-foreground-secondary">
              When I'm not behind my desk I love to spend time with family and friends or spend long days in
              the saddle on my bicycles. If you'd like to know what I'm up to here's a link to my
              <a
                href="https://veloviewer.com"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-brand-600 hover:text-brand-500 underline underline-offset-2 transition-colors"
              >VeloViewer profile</a>.
            </p>
          </div>
        </div>
      </Card>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-display mb-4 text-2xl font-bold text-foreground">Want to get in touch?</h2>
      <p class="mb-8 text-foreground-secondary">
        Remember: no job offers please! But I'm happy to chat otherwise.
      </p>
      <Button href="/contact" size="lg">
        <Icon name="mail" size="sm" />
        Contact Me
      </Button>
    </div>
  </section>
</PageLayout>
