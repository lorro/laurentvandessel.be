---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import ContactForm from '@/components/patterns/ContactForm.vue';
import siteConfig from '@/config/site.config';
---

<PageLayout
  title="Contact"
  description="Get in touch with Laurent Van Dessel — but please, no job offers!"
>
  <Hero layout="centered" size="sm" showGrid>
    <Badge slot="badge" pill pulse>Get in Touch</Badge>

    <h1 slot="title">
      Let's <span class="text-brand-500">connect.</span>
    </h1>

    <p slot="description">
      Have a question or just want to say hello? Feel free to reach out.
      Just please — no job opportunities, thank you! 😊
    </p>
  </Hero>

  <section class="py-20 bg-background-secondary">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">

        <!-- Vue contact form -->
        <Card padding="lg">
          <h2 class="text-2xl font-display font-bold text-foreground mb-6">Send a message</h2>
          <ContactForm client:load />
        </Card>

        <!-- Contact info -->
        <div class="flex flex-col justify-center">
          <h2 class="font-display text-2xl font-bold text-foreground mb-8">
            Other ways to reach me
          </h2>

          <div class="space-y-4">
            <a href={`mailto:${siteConfig.email}`} class="block">
              <Card hover padding="sm">
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-600 shrink-0">
                    <Icon name="mail" size="md" />
                  </div>
                  <div>
                    <p class="text-sm text-foreground-muted">Email</p>
                    <p class="font-medium text-foreground">{siteConfig.email}</p>
                  </div>
                </div>
              </Card>
            </a>

            <a href="https://github.com/lorro" target="_blank" rel="noopener noreferrer" class="block">
              <Card hover padding="sm">
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-600 shrink-0">
                    <Icon name="github" size="md" />
                  </div>
                  <div>
                    <p class="text-sm text-foreground-muted">GitHub</p>
                    <p class="font-medium text-foreground">github.com/lorro</p>
                  </div>
                </div>
              </Card>
            </a>

            <Card padding="sm" class="border-warning/30 bg-warning-light/30">
              <div class="flex items-start gap-3">
                <Icon name="info" size="sm" class="mt-0.5 shrink-0 text-warning-foreground" />
                <p class="text-sm text-foreground-secondary">
                  Please note: I'm not looking for new job opportunities at this time.
                  I won't respond to unsolicited job offers.
                </p>
              </div>
            </Card>
          </div>
        </div>

      </div>
    </div>
  </section>
</PageLayout>
