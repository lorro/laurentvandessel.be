---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
---

<LandingLayout
  description="Full-stack web developer based in Antwerp, Belgium. Working with HTML, CSS, PHP, JavaScript, Vue.js, WordPress and CakePHP."
  includeOrgSchema={true}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-background py-24 md:py-32">
    <!-- Soft gradient blobs -->
    <div class="pointer-events-none absolute -left-32 -top-32 h-[500px] w-[500px] rounded-full bg-brand-400/10 blur-[96px]"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-[420px] w-[420px] rounded-full bg-brand-500/10 blur-[80px]"></div>
    <div class="pointer-events-none absolute left-1/2 top-1/4 h-[300px] w-[600px] -translate-x-1/2 rounded-full bg-brand-300/6 blur-[64px]"></div>

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-start lg:gap-10">
        <div class="w-full text-center lg:w-3/5 lg:text-left">
          <Badge pill class="mb-6 inline-flex">
            <span class="mr-1.5">👋</span>
            Full-stack Web Developer · Antwerp, Belgium
          </Badge>

          <h1 class="font-display mb-6 text-5xl font-bold tracking-tight text-foreground md:text-6xl lg:text-7xl">
            Laurent<br /><span class="text-brand-500">Van Dessel</span>
          </h1>

          <p class="mb-10 max-w-2xl text-lg leading-relaxed text-foreground-secondary">
            I'm a full-stack web developer at <strong class="text-foreground">Inbound</strong>, building
            websites and web applications with HTML, CSS, PHP, JavaScript, Vue.js, WordPress and CakePHP.
          </p>

          <div class="flex flex-wrap justify-center gap-4 lg:justify-start">
            <Button size="lg" href="/contact">
              <Icon name="mail" size="sm" />
              Get in Touch
            </Button>
            <Button size="lg" variant="outline" href="/about">
              About Me
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        </div>

        <div class="relative w-full lg:w-2/5">
          <img
            src="/developer.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="mx-auto w-full max-w-[420px] opacity-80 lg:max-w-none"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About / TL;DR Section -->
  <section class="bg-background-secondary py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-4 flex items-center gap-3">
        <span class="font-display text-sm font-semibold uppercase tracking-wider text-brand-500">TL;DR</span>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <h2 class="font-display mb-6 text-3xl font-bold text-foreground md:text-4xl">About Me</h2>

      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-foreground-secondary">
        I'm Laurent Van Dessel and work as a full-stack web developer at Inbound. I currently live in
        Antwerp, Belgium: some of you may have heard of it! 😜 By the way, I would like to ask to not
        contact me for any job opportunities, I have no outbound ambitions at the moment.
      </p>

      <Button variant="outline" href="/about">
        Read more
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="bg-background py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display mb-12 text-2xl font-bold text-foreground">What I Work With</h2>

      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {[
          { name: 'HTML & CSS', icon: 'code', desc: 'Semantic markup and modern styling' },
          { name: 'PHP', icon: 'server', desc: 'Server-side development' },
          { name: 'JavaScript & Vue.js', icon: 'zap', desc: 'Modern JS and tooling' },
          { name: 'WordPress', icon: 'layers', desc: 'Building CMS websites' },
          { name: 'CakePHP & Laravel', icon: 'squares', desc: 'Modern PHP applications' },
          { name: 'AI Tooling', icon: 'sparkles', desc: 'Claude Code & Open Code workflows' },
        ].map(({ name, icon, desc }) => (
          <Card padding="md">
            <div class="flex items-start gap-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-brand-600">
                <Icon name={icon} size="sm" />
              </div>
              <div>
                <p class="font-semibold text-foreground">{name}</p>
                <p class="mt-0.5 text-sm text-foreground-muted">{desc}</p>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>
</LandingLayout>
